{
  "name": "vless",
  "version": "0.1.0",
  "description": "Privacy-preserving on-device browser agent with visual perception",
  "private": true,
  "type": "module",
  "scripts": {
    "setup:ort": "node scripts/copy-ort-wasm.mjs",
    "dev": "node scripts/copy-ort-wasm.mjs && wxt",
    "build": "node scripts/copy-ort-wasm.mjs && wxt build",
    "build:firefox": "node scripts/copy-ort-wasm.mjs && wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "fmt": "prettier --write src/",
    "models": "node scripts/download-models.mjs",
    "server": "node server/index.cjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@mlc-ai/web-llm": "^0.2.84",
    "idb": "^8.0.0",
    "onnxruntime-web": "^1.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  }
}
